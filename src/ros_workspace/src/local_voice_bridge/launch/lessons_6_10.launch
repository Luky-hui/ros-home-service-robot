<launch>
  <arg name="config_file" default="$(find local_voice_bridge)/config/voice_config.yaml"/>
  <arg name="continuous_listen" default="true"/>
  <arg name="execute_intents" default="true"/>
  <arg name="start_control" default="true"/>
  <arg name="start_navigation" default="true"/>

  <include file="$(find local_voice_bridge)/launch/local_voice.launch">
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="continuous_listen" value="$(arg continuous_listen)"/>
    <arg name="execute_intents" value="$(arg execute_intents)"/>
  </include>

  <include if="$(arg start_control)" file="$(find robot_audio)/launch/voice_control.launch"/>
  <include if="$(arg start_navigation)" file="$(find robot_audio)/launch/voice_nav.launch"/>
</launch>
