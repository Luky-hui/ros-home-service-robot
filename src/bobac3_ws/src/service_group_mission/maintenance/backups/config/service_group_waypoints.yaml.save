    x: -0.290
    y: -10.070
    yaw: -0.008
  shenzhen:
    frame_id: map
    x: 10.105
    y: 0.991
    nav_x: 1.120
    nav_y: 1.066
    nav_yaw: current
    direct_fallback: true
    max_direct_fallback_distance: 0.18
    direct_accept_distance: 0.18
    yaw: 3.125
  shanghai:
    frame_id: map
    x: 1.114
    y: 1.971
    nav_x: 1.089
    nav_y: 2.046
    nav_yaw: current
    direct_fallback: true
    max_direct_fallback_distance: 0.18
    direct_accept_distance: 0.18
    yaw: 3.122
  beijing:
    frame_id: map
    x: 2.531
    y: 0.230
    nav_x: 2.506
    nav_y: 0.270
    nav_yaw: current
    direct_fallback: true
    max_direct_fallback_distance: 0.18
