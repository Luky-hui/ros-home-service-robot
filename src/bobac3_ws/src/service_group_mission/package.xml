<?xml version="1.0"?>
<package format="2">
  <name>service_group_mission</name>
  <version>0.1.0</version>
  <description>Mission orchestrator for the service-group welcome and patrol tasks.</description>
  <maintainer email="maintainer@example.com">robot_user</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>actionlib</depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>cv_bridge</depend>
  <depend>face_rec</depend>
  <depend>robot_audio</depend>
  <depend>raicom_vision</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
