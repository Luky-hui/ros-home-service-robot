<launch>
    <node name="head_camera" pkg="usb_cam" type="usb_cam_node" output="screen"
          respawn="$(optenv HEAD_CAMERA_RESPAWN true)"
          respawn_delay="$(optenv HEAD_CAMERA_RESPAWN_DELAY 2.0)" >
        <!--这是手臂摄像头的launch文件，请修改-->
        <param name="video_device" command="$(find ar_pose)/scripts/resolve_head_camera_device.sh" />
   	    <param name="image_width" value="$(optenv HEAD_CAMERA_WIDTH 640)" />
    	<param name="image_height" value="$(optenv HEAD_CAMERA_HEIGHT 360)" />
        <param name="framerate" value="$(optenv HEAD_CAMERA_FRAMERATE 10)" />
        <param name="pixel_format" value="$(optenv HEAD_CAMERA_PIXEL_FORMAT yuyv)" />
        <param name="camera_frame_id" value="head_camera_link" />
        <param name="io_method" value="mmap"/>
        <param name="camera_name" value="head_camera"/>
        <param name="camera_info_url" type="string" value="file://$(find ar_pose)/cam_info/head_camera.yaml"/>
    </node>
</launch>
